# =====================================================================
# Konfigurasi deploy Docker (docker-compose.yml)
#   cp .env.docker.example .env.docker
#   Isi APP_KEY, APP_URL, dan semua password di bawah.
# =====================================================================
APP_NAME="Finance Shafa"
APP_ENV=production
# Buat dengan: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Koneksi aplikasi ke service "mysql" ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=finflow_db
DB_USERNAME=finance
DB_PASSWORD=ganti_password_kuat

# --- Inisialisasi container MySQL (harus sama dengan DB_* di atas) ---
MYSQL_DATABASE=finflow_db
MYSQL_USER=finance
MYSQL_PASSWORD=ganti_password_kuat
MYSQL_ROOT_PASSWORD=ganti_password_root_kuat

# --- Tanpa Redis: session/cache di database, queue sinkron ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set true bila diakses lewat HTTPS (reverse proxy / load balancer TLS)
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Aplikasi keuangan ---
FINANCE_COMPANY_NAME="PT Finflow"
FINANCE_CURRENCY=IDR
FINANCE_ATTACHMENT_DISK=local
FINANCE_ATTACHMENT_MIMES=pdf,jpg,jpeg,png
FINANCE_ATTACHMENT_MAX_KB=5120
FINANCE_ATTACHMENT_REQUIRED_ABOVE=1000000
FINANCE_ATTACHMENT_URL_TTL=30
FINANCE_ANTIVIRUS_ENABLED=false
FINANCE_CLAMAV_BINARY=clamscan
FINANCE_APPROVAL_TIERED=false
FINANCE_APPROVAL_MANAGER_THRESHOLD=10000000
FINANCE_JOURNAL_REF_FORMAT="JV-{YYYY}-{MM}-{SEQ:4}"
FINANCE_TRX_REF_FORMAT="{TYPE}-{YYYY}-{MM}-{SEQ:4}"
FINANCE_AUTO_POST_ON_APPROVE=false
# true + jalankan profile "scheduler" untuk posting batch otomatis setiap hari 23:30
FINANCE_SCHEDULED_POSTING=false

# Seed data inti (user per peran, COA, periode, template) saat database masih kosong
SEED_ON_FIRST_RUN=true
