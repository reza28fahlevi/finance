APP_NAME="Finance Shafa"
APP_ENV=production
# Isi dengan: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://finance.example.com
# Perlu config/app.php membaca env('APP_TIMEZONE')
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: MySQL (InnoDB) ---
DB_CONNECTION=mysql
# Di docker-compose pakai nama service, mis. mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=finflow_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session / cache / queue: driver database (tanpa Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=finflow_cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@finflow.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# Konfigurasi aplikasi keuangan (RANCANGAN.md)
# Dibaca lewat config/finance.php. Ini nilai default; menu
# Pengaturan Umum (tabel settings) boleh menimpanya saat runtime.
# =====================================================================
FINANCE_COMPANY_NAME="PT Finflow"
FINANCE_CURRENCY=IDR

# Lampiran: PDF/JPG/PNG, maks 5 MB, disimpan privat di storage/app/private
FINANCE_ATTACHMENT_DISK=local
FINANCE_ATTACHMENT_MIMES=pdf,jpg,jpeg,png
FINANCE_ATTACHMENT_MAX_KB=5120
# Nominal di atas angka ini wajib minimal 1 lampiran
FINANCE_ATTACHMENT_REQUIRED_ABOVE=1000000
# Masa berlaku URL unduh bertoken (menit)
FINANCE_ATTACHMENT_URL_TTL=30

# Pindai antivirus (ClamAV); matikan jika belum tersedia
FINANCE_ANTIVIRUS_ENABLED=false
FINANCE_CLAMAV_BINARY=clamscan

# Approval bertingkat: >= nilai ini wajib Manager, di bawahnya cukup Supervisor
FINANCE_APPROVAL_TIERED=false
FINANCE_APPROVAL_MANAGER_THRESHOLD=10000000

# Format nomor referensi ({YYYY}, {MM}, {SEQ:n} = nomor urut n digit)
# {TYPE} = kode jenis transaksi (BKM, BKK, INV-OUT, INV-IN)
FINANCE_JOURNAL_REF_FORMAT="JV-{YYYY}-{MM}-{SEQ:4}"
FINANCE_TRX_REF_FORMAT="{TYPE}-{YYYY}-{MM}-{SEQ:4}"

# Posting batch terjadwal via Laravel Scheduler (butuh cron schedule:run)
FINANCE_SCHEDULED_POSTING=false

# Langsung posting jurnal otomatis ke GL saat transaksi di-approve.
# false = jurnal berstatus DRAFT dan diposting Akuntan (manual / Posting Batch)
FINANCE_AUTO_POST_ON_APPROVE=false
